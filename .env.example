# Postgres connection used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://vasync:vasync@localhost:5432/vasync

# Single-guild identity + role enforcement (see MVP spec section 5)
VASYNC_GUILD_ID=
ENTITY_ROLE_ID=
RESEARCHER_ROLE_ID=
STAFF_ROLE_ID=

# Shared secret the bot and dashboard attach to every request so this
# service can trust the X-Discord-* identity headers it receives.
SERVICE_TOKEN=

# Uvicorn bind config
API_HOST=0.0.0.0
API_PORT=8000
