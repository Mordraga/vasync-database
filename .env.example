# Postgres connection used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://vasync:vasync@localhost:5432/vasync

# Single-guild identity check (see MVP spec section 5). Which Discord roles
# map to which VAsync role is server_roles table data now, managed via
# POST/DELETE /roles (staff-only), not env vars - seed it after first deploy.
VASYNC_GUILD_ID=

# Shared secret the bot and dashboard attach to every request so this
# service can trust the X-Discord-* identity headers it receives.
SERVICE_TOKEN=

# Uvicorn bind config
API_HOST=0.0.0.0
API_PORT=8000
